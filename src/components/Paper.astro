---
// Reactive paper: a stronger copy of the grain, revealed around the pointer. Fixed to the viewport.
// The static grain is body::before in global.css.
// ponytail: grain mask is a 2D trick. Upgrade path is a WebGL normal-mapped paper if it ever needs true relief.
---

<div class="paper" data-pointer="client" aria-hidden="true"></div>

<style>
	.paper {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		--px: -999px; /* no light until the pointer or the touch drift sets it */
		--py: -999px;
		background: url(/img/grain.webp);
		opacity: 0.9;
		mask-image: radial-gradient(circle 220px at var(--px) var(--py), #000 0%, transparent 100%);
	}

	@media (prefers-reduced-motion: reduce) {
		.paper { display: none; }
	}
</style>

<script>
	// The only per-frame work for the paper and the landscape tie-in. Each [data-pointer] element gets
	// --px and --py in its own coordinates. Offsets are read on load and resize only, never in the frame.
	const els = [...document.querySelectorAll<HTMLElement>('[data-pointer]')];
	let origin: number[][] = [];
	let w = innerWidth, h = innerHeight;
	let cx = w / 2, cy = h * 0.4, px = cx, py = cy;
	let queued = false;
	let floating = false, since = 0, from = [cx, cy];

	function measure() {
		w = innerWidth; h = innerHeight;
		origin = els.map((el) => {
			if (el.dataset.pointer === 'client') return [0, 0];
			const r = el.getBoundingClientRect();
			return [r.left + scrollX, r.top + scrollY];
		});
		write();
	}

	function write() {
		queued = false;
		els.forEach((el, i) => {
			const fixed = el.dataset.pointer === 'client';
			el.style.setProperty('--px', `${fixed ? cx : px - origin[i][0]}px`);
			el.style.setProperty('--py', `${fixed ? cy : py - origin[i][1]}px`);
		});
	}

	// No pointer on the page (touch devices, before the mouse arrives, after it leaves): the light floats
	// on its own, a slow 40 second loop. It eases out from wherever it was over 2 seconds, so it never jumps.
	function float() {
		if (floating) return;
		floating = true; since = 0; from = [cx, cy];
		requestAnimationFrame(step);
	}
	function step(t: number) {
		if (!floating) return;
		since ||= t;
		const a = ((t - since) / 40000) * 2 * Math.PI;
		const k = Math.min(1, (t - since) / 2000);
		const ease = k * k * (3 - 2 * k);
		cx = from[0] + (w * (0.5 + 0.35 * Math.sin(a)) - from[0]) * ease;
		cy = from[1] + (h * (0.4 + 0.2 * Math.sin(2 * a)) - from[1]) * ease;
		px = cx + scrollX; py = cy + scrollY;
		write();
		requestAnimationFrame(step);
	}

	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		measure();
		addEventListener('resize', measure);
		float();
		if (matchMedia('(hover: hover)').matches) {
			// The mouse takes over the moment it moves on the page, and hands back when it leaves the window.
			addEventListener('pointermove', (e) => {
				floating = false;
				cx = e.clientX; cy = e.clientY; px = e.pageX; py = e.pageY;
				if (!queued) { queued = true; requestAnimationFrame(write); }
			}, { passive: true });
			document.addEventListener('pointerout', (e) => { if (!e.relatedTarget) float(); });
		}
	}
</script>
