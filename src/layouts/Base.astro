---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Paper from '../components/Paper.astro';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
// ponytail: canonical, Open Graph and JSON-LD arrive in Phase 5.
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{noindex && <meta name="robots" content="noindex" />}
	</head>
	<body>
		<Paper />
		<header data-snap class="nav wrap">
			<a class="label name" href="/">Chander Maurya Kumbkarni</a>
			<!-- ponytail: anchors on the home page until /decisions/ and /writing/ exist in Phase 3 -->
			<nav aria-label="Main">
				<a class="label" href="/#work">Work</a>
				<a class="label" href="/#decisions">Decisions</a>
				<a class="label" href="/#writing">Writing</a>
				<a class="label" href="/#contact">Contact</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="foot wrap">
			<p>From Himachal, based in Delhi. I lift, run, brew coffee and write poems that sound a thousand years old.</p>
			<p class="label links">
				<a href="mailto:mkumbkarni@gmail.com">Email</a>
				<a href="https://linkedin.com/in/mkumbkarni">LinkedIn</a>
				<a href="https://github.com/akamaurya">GitHub</a>
			</p>
			<p class="t-data">
				Ink landscape generated with <a href="https://github.com/LingDong-/shan-shui-inf">shan-shui-inf</a> by Lingdong Huang, MIT licence.
			</p>
		</footer>
	</body>
</html>

<style>
	.nav {
		min-height: var(--nav-h);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.25rem 1.5rem;
		padding-block: 0.75rem;
	}
	.nav a { text-decoration: none; }
	.nav nav { display: flex; flex-wrap: wrap; gap: 0 1.25rem; }
	.nav nav a { color: var(--ink-2); }
	.nav nav a:hover { color: var(--accent); }

	.foot {
		border-top: 1px solid var(--rule);
		padding-block: 2.5rem 3rem;
		font-size: 0.94rem;
	}
	.foot p { margin: 0 0 1rem; }
	.links { display: flex; flex-wrap: wrap; gap: 0 1.25rem; }
	.links a { color: var(--accent); text-decoration: none; }
	.links a:hover { text-decoration: underline; }
</style>

<script>
	// Section snapping on desktop. When a scroll comes to rest with a section edge on screen, glide to that
	// edge in the direction of travel. Sections taller than the screen still scroll freely inside.
	// ponytail: native CSS scroll-snap would be zero JS, but it snaps a single mouse-wheel tick straight back
	// to where it started. Revisit if browsers add directional snapping for wheels.
	const desktop = '(min-width: 768px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)';
	if (matchMedia(desktop).matches) {
		let points: number[] = [];
		let rest = scrollY;
		let gliding = false;
		let timer = 0;

		const measure = () => {
			const max = document.documentElement.scrollHeight - innerHeight;
			const tops = [...document.querySelectorAll('[data-snap]')].map((el) => Math.round(el.getBoundingClientRect().top + scrollY));
			points = [...new Set([...tops.map((t) => Math.min(t, max)), max])].sort((a, b) => a - b);
		};

		const settle = () => {
			const y = Math.round(scrollY);
			const dir = Math.sign(y - rest);
			rest = y;
			if (gliding) { gliding = false; return; }
			if (!dir || points.some((p) => Math.abs(p - y) < 2)) return;
			const edge = points.find((p) => p > y && p < y + innerHeight); // first section edge on screen
			if (edge === undefined) return; // mid-way through a long section: leave it alone
			let target = edge;
			if (dir < 0) {
				const prev = points.filter((p) => p < y).at(-1) ?? 0;
				target = edge - prev <= innerHeight ? prev : edge - innerHeight;
			}
			gliding = true;
			scrollTo({ top: target, behavior: 'smooth' });
		};

		measure();
		addEventListener('load', measure);
		addEventListener('resize', measure);
		if ('onscrollend' in window) addEventListener('scrollend', settle);
		else addEventListener('scroll', () => { clearTimeout(timer); timer = window.setTimeout(settle, 120); }, { passive: true });
	}
</script>
